{
  "name": "hbn-thickness-analyzer",
  "productName": "HBN Thickness Analyzer",
  "version": "2.0.0",
  "description": "Advanced 2D nanomaterial thickness detection software for hexagonal boron nitride analysis",
  "main": "src/index.js",
  "scripts": {
    "start": "electron-forge start",
    "dev": "concurrently -n backend,frontend,desktop -c cyan,green,magenta \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:desktop\"",
    "dev:backend": "python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --reload",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:desktop": "wait-on tcp:3000 && cross-env ELECTRON_START_URL=http://127.0.0.1:3000 electron-forge start",
    "test:backend": "pytest backend/tests",
    "samples:generate": "python backend/scripts/generate_mock_samples.py",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\""
  },
  "keywords": ["nanomaterial", "2d-materials", "hbn", "boron-nitride", "thickness-analysis", "microscopy", "materials-science"],
  "author": {
    "name": "amitsabnis2004",
    "email": "asabnis2@gitam.in"
  },
  "license": "MIT",
  "dependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.7.0",
    "@electron-forge/maker-deb": "^7.7.0",
    "@electron-forge/maker-rpm": "^7.7.0",
    "@electron-forge/maker-squirrel": "^7.7.0",
    "@electron-forge/maker-zip": "^7.7.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.7.0",
    "@electron-forge/plugin-fuses": "^7.7.0",
    "@electron/fuses": "^1.8.0",
    "electron": "34.3.0",
    "wait-on": "^8.0.3"
  }
}
